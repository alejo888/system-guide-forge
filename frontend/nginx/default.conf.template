# Rendered by the nginx image entrypoint with envsubst; only defined environment variables
# (BACKEND_HOST, BACKEND_PORT, NGINX_RESOLVER) are substituted, nginx variables stay intact.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    # Resolve the backend lazily so the container starts before the backend is healthy.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    location /api/ {
        set $sgf_backend http://${BACKEND_HOST}:${BACKEND_PORT};
        # No URI part: the original request URI (/api/...) is passed through unchanged.
        proxy_pass $sgf_backend;
        proxy_http_version 1.1;

        # Keep the original Host, like the dev proxy's changeOrigin: false.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;

        # Starting an analysis (POST /api/applications/{id}/analyses) crawls the target synchronously
        # with Playwright and can take minutes; allow up to 10 minutes per response.
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        # Edited documents are sent back as JSON bodies (PUT /api/documents/{id}).
        client_max_body_size 10m;
    }

    # Content-hashed build output (outputHashing: all), e.g. main-Q6JFYA5K.js.
    location ~* "-[A-Z0-9]{8}\.(?:js|css|woff2?|ttf|svg|png|jpe?g|gif|webp|ico)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # SPA fallback for Angular router paths such as /analysis/:id.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
